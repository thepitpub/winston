# =====================================================================
# Continental Heritage — variáveis de ambiente (exemplo, SEM segredos).
# Copie para .env.local (local) ou cadastre na Vercel (produção).
# =====================================================================

# --- Supabase (projeto cfigjxuyjklchsyhdgrg) --------------------------
NEXT_PUBLIC_SUPABASE_URL=https://cfigjxuyjklchsyhdgrg.supabase.co
# Chave publicável (sb_publishable_…): pode ir ao navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (sb_secret_…): SÓ servidor. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Aplicação ---------------------------------------------------------
# 32+ caracteres aleatórios (openssl rand -hex 32). Assina o QR da
# credencial e cifra os códigos da entrega manual. Trocar invalida QRs
# em circulação (vencem em 60 s de qualquer forma) e códigos pendentes.
CH_SEGREDO=
# Endereço público (links de convite). Em produção, o domínio definitivo.
CH_URL=http://localhost:3300

# --- Código temporário de acesso --------------------------------------
# manual | twilio | whatsapp_cloud  (ver docs/PROVEDORES.md)
CH_OTP_PROVEDOR=manual
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_IDIOMA=pt_BR

# --- IA (Winston) ------------------------------------------------------
# Só "nenhum" por enquanto: o Winston usa regras fixas e diz isso na tela.
CH_IA_PROVEDOR=nenhum

# --- Desenvolvimento ---------------------------------------------------
# 1 liga /dev/entrar?como=membro|equipe (identidades sintéticas). É
# ignorado com NODE_ENV=production. NUNCA cadastre na Vercel.
CH_DEV_ATALHO=
